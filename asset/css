:root{--primary:#1d4ed8;--bg:#f3f4f8;--ok:#15803d;--warn:#d97706;--danger:#dc2626;--border:#e2e5ec}
*{box-sizing:border-box}
[v-cloak]{display:none}
body{margin:0;font-family:"Segoe UI",system-ui,sans-serif;background:var(--bg);color:#1f2937}
.topbar{background:var(--primary);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:.7rem 1.5rem;flex-wrap:wrap;gap:.5rem;position:sticky;top:0;z-index:20}
.topbar h1{margin:0;font-size:1.3rem}.topbar small{font-weight:400;opacity:.8;font-size:.8rem;margin-left:.4rem}
nav button{background:transparent;border:0;color:#dbe4ff;padding:.5rem 1rem;margin-left:.3rem;border-radius:8px;cursor:pointer;font-size:.95rem}
nav button:hover{background:rgba(255,255,255,.15)}nav button.active{background:#fff;color:var(--primary);font-weight:600}
.container{max-width:1200px;margin:1.2rem auto;padding:0 1rem}
.card{background:#fff;border-radius:12px;padding:1.2rem;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.card.narrow{max-width:820px;margin:auto}
.card-head{display:flex;justify-content:space-between;align-items:center}
h2{margin:.2rem 0 1rem}
.muted{color:#6b7280;font-size:.85rem}
.filters{display:flex;flex-wrap:wrap;gap:.8rem;align-items:flex-end;margin-bottom:.6rem}
label{display:flex;flex-direction:column;font-size:.85rem;gap:.25rem;font-weight:600}
label.check{flex-direction:row;align-items:center;font-weight:500;gap:.4rem}
label.grow{flex:1;min-width:200px}
input,select{padding:.5rem .6rem;border:1px solid #cbd1dc;border-radius:8px;font-size:.92rem;font-family:inherit;width:100%}
.filters input,.filters select{width:auto}.filters label.grow input{width:100%}
.filters label.check input{width:auto}
input:focus,select:focus{outline:2px solid #93b4ff;border-color:var(--primary)}
input.readonly,input:disabled{background:#f1f3f7;color:#555}
.btn{padding:.5rem .9rem;border:1px solid #cbd1dc;background:#fff;border-radius:8px;cursor:pointer;font-size:.9rem}
.btn:hover{background:#f1f3f7}
.btn.primary{background:var(--primary);color:#fff;border-color:var(--primary)}.btn.primary:hover{background:#1e40af}
.btn.danger{background:var(--danger);color:#fff;border-color:var(--danger)}
.pill{background:var(--danger);color:#fff;border-radius:999px;padding:0 .5rem;font-size:.75rem}
.table-wrap{overflow-x:auto;padding-bottom:140px;margin-bottom:-140px}
table{border-collapse:collapse;width:100%;font-size:.9rem}
th,td{padding:.6rem .7rem;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}
th{background:#f7f8fb;white-space:nowrap}
.num{text-align:right;white-space:nowrap}
tbody tr:hover{background:#f9fbff}
.row-warn{background:#fffaf0}.row-danger{background:#fff4f4}
.empty{text-align:center;color:#6b7280;padding:1.5rem}
.badge-ok{color:var(--ok);font-weight:600}.badge-warn{color:var(--warn);font-weight:600}.badge-danger{color:var(--danger);font-weight:600}
.status-cell{position:relative;cursor:help;white-space:nowrap}
.tooltip{position:absolute;z-index:10;left:0;top:100%;background:#1f2937;color:#fff;padding:.6rem .8rem;border-radius:8px;min-width:200px;max-width:280px;white-space:normal;font-size:.82rem;box-shadow:0 4px 12px rgba(0,0,0,.25)}
.actions-cell{white-space:nowrap}
.icon-btn{border:0;background:transparent;cursor:pointer;font-size:1.05rem;padding:.2rem .4rem;border-radius:6px}.icon-btn:hover{background:#eceff5}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.form-grid .full{grid-column:1/-1}
.err{color:var(--danger);font-weight:500}
.actions{display:flex;justify-content:flex-end;gap:.6rem;margin-top:1rem}
kbd{background:#eceff5;border:1px solid #cbd1dc;border-radius:4px;padding:0 .35rem;font-size:.8rem}
.modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.5);display:flex;align-items:center;justify-content:center;z-index:50;padding:1rem}
.modal{background:#fff;border-radius:12px;width:100%;max-width:640px;max-height:92vh;overflow:auto;padding:1.2rem}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.8rem}.modal-head h3{margin:0}
.do-card{border:1px solid var(--border);border-radius:10px;padding:1rem;margin-top:1rem}
.do-head{display:flex;justify-content:space-between;align-items:center}.do-head h3{margin:0}
.status-pill{padding:.2rem .7rem;border-radius:999px;font-size:.8rem;font-weight:600}
.status-pill.info{background:#dbeafe;color:#1d4ed8}.status-pill.warn{background:#fef3c7;color:#b45309}.status-pill.ok{background:#dcfce7;color:var(--ok)}
.detail{display:grid;grid-template-columns:140px 1fr;gap:.3rem .8rem;margin:.8rem 0}.detail dt{color:#6b7280}.detail dd{margin:0}
.timeline{list-style:none;padding-left:1rem;border-left:3px solid #c7d2fe;margin:.5rem 0}
.timeline li{padding:.3rem 0 .3rem .8rem;display:flex;gap:.8rem;flex-wrap:wrap}.time{color:#6b7280;font-size:.85rem}
.add-progress{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-top:.5rem}.add-progress input{flex:1;min-width:200px}
.paket-detail{background:#f1f5ff;border-radius:8px;padding:.7rem 1rem}.paket-detail ul{margin:.3rem 0 0;padding-left:1rem;list-style:none}
.toast{position:fixed;bottom:1.2rem;left:50%;transform:translateX(-50%);background:#111827;color:#fff;padding:.6rem 1.2rem;border-radius:999px;z-index:60}
.fade-enter-active,.fade-leave-active{transition:opacity .2s}.fade-enter,.fade-leave-to{opacity:0}
@media(max-width:640px){.form-grid{grid-template-columns:1fr}.detail{grid-template-columns:100px 1fr}}

